# ============================================================
# Домены (используются Caddy и Vikunja)
# ============================================================

LOGSEQ_DOMAIN=logseq.example.com
SYNC_DOMAIN=sync.example.com
VIKUNJA_DOMAIN=vikunja.example.com

# ============================================================
# Logseq Sync Server
# ============================================================

# Порт sync-сервера внутри контейнера
DB_SYNC_PORT=8787

# Внешний HTTPS-адрес sync-сервера, который видит Logseq-клиент.
# Должен совпадать с SYNC_DOMAIN
DB_SYNC_BASE_URL=https://sync.example.com

# Каталог внутри контейнера, куда пишутся данные синхронизации
DB_SYNC_DATA_DIR=/app/data

# Хранение метаданных и состояния синхронизации
DB_SYNC_STORAGE_DRIVER=sqlite

# Хранение вложений
DB_SYNC_ASSETS_DRIVER=filesystem

# Уровень логирования: debug, info, warn, error.
DB_SYNC_LOG_LEVEL=info

# Сгенерировать: openssl rand -hex 32
DB_SYNC_ADMIN_TOKEN=<TOKEN>

# ------------------------------------------------------------
# Аутентификация Logseq-клиентов через официальный AWS Cognito
# ------------------------------------------------------------
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_dtagLnju8
COGNITO_CLIENT_ID=69cs1lgme7p8kbgld8n5kseii6
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_dtagLnju8/.well-known/jwks.json

# ============================================================
# Vikunja
# ============================================================

# Сгенерировать: openssl rand -hex 32
VIKUNJA_SERVICE_JWTSECRET=<TOKEN>

# Пароль для подключения к базе данных.
# Сгенерировать: openssl rand -hex 16
POSTGRES_PASSWORD=<PASSWORD>

# Включить возможность регистрации новых пользователей
VIKUNJA_SERVICE_ENABLEREGISTRATION=false

# ============================================================
# Бэкап через WebDAV
# ============================================================

# WebDAV-адрес
BACKUP_WEBDAV_URL=https://webdav.yandex.ru

# WebDAV-логин
BACKUP_WEBDAV_USER=<WEBDAV_USER>

# WebDAV-пароль
# Если пароль содержит пробелы, то обернуть в кавычки
BACKUP_WEBDAV_PASS=<WEBDAV_APP_PASSWORD>

# Папка, куда складываются бэкапы
BACKUP_WEBDAV_DIR=selfhosted-backups

# Сколько последних дневных бэкапов хранить (локально и на Яндексе)
BACKUP_RETENTION_DAYS=7
